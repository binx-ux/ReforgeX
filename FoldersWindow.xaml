<Window x:Class="ReforgeX.FoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Addon folders"
        Width="640"
        Height="480"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
      <Button DockPanel.Dock="Right" Content="Add folder" Width="110" Margin="12,0,0,0" Style="{StaticResource AccentButton}" Click="Add_Click" VerticalAlignment="Top"/>
      <StackPanel>
        <TextBlock Text="Addon folders" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Add the folder that contains your addon folders, not a single file inside one." Margin="0,4,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
    <Button DockPanel.Dock="Bottom" Content="Done" Width="96" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Done_Click" Style="{StaticResource AccentButton}"/>
    <ListBox x:Name="Roots" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" ItemContainerStyle="{StaticResource PlainRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,2,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#8FA86A"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Exists}" Value="False">
                        <Setter Property="Foreground" Value="#C4A15A"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Open" MinWidth="72" Margin="0,0,8,0" Click="Open_Click">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Exists}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Content="Remove" MinWidth="76" Click="Remove_Click">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding UserAdded}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
