<Window x:Class="ReforgeX.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReforgeX"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <StackPanel Margin="20">
    <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="Message" Margin="0,10,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="Detail" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    <TextBlock x:Name="ChoiceLabel" Text="Put them in" Margin="0,14,0,6" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
    <ListBox x:Name="Choice" MaxHeight="160" Visibility="Collapsed" ItemContainerStyle="{StaticResource PlainRow}" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Field}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CancelBtn" Content="Cancel" MinWidth="88" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button x:Name="ExtraBtn" Content="Skip existing" MinWidth="120" Margin="0,0,8,0" Visibility="Collapsed" Click="Extra_Click"/>
      <Button x:Name="AcceptBtn" Content="OK" MinWidth="100" Click="Accept_Click" Style="{StaticResource AccentButton}"/>
    </StackPanel>
  </StackPanel>
</Window>
