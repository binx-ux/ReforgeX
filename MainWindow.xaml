<Window x:Class="ReforgeX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReforgeX"
        Width="1080"
        Height="700"
        MinWidth="880"
        MinHeight="520"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/reforgex.ico"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        AllowDrop="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="16,14,16,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/Assets/mark.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="ReforgeX" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="Subtitle" Text="Arma Reforger mods" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Column="1" Width="280" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="Search_Changed" ToolTip="Search by name or id. Ctrl+F"/>
        <TextBlock x:Name="SearchHint" Text="Search" Foreground="#6F6C62" IsHitTestVisible="False" VerticalAlignment="Center" Margin="28,0,0,0"/>
        <Grid Width="14" Height="14" Margin="8,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Stroke="#8E8B80" StrokeThickness="1.4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"/>
          <Path Data="M7,8 L12,13" Stroke="#8E8B80" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
      </Grid>

      <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="FilterBtn" Content="All mods" MinWidth="108" Margin="0,0,8,0" Click="FilterBtn_Click" ToolTip="Show all mods, only ones the game loads, or only ones turned off">
            <Button.ContextMenu>
              <ContextMenu x:Name="FilterMenu"/>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="RefreshBtn" Content="Refresh" Width="84" Margin="0,0,8,0" Click="Refresh_Click" ToolTip="Read the addon folders again"/>
          <Button x:Name="FoldersBtn" Content="Folders" Width="84" Margin="0,0,8,0" Click="Folders_Click" ToolTip="Choose where ReforgeX looks"/>
          <Button x:Name="ImportBtn" Content="Import" Width="84" Click="Import_Click" ToolTip="Bring in a zip or an addon folder"/>
        </StackPanel>
        <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="Reading addon folders..."/>
      </DockPanel>
    </Grid>

    <Border x:Name="ColumnHead" Grid.Row="1" Background="#1E201C" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Visibility="Collapsed">
      <Grid Height="36" Margin="8,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="46"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="108"/>
          <ColumnDefinition Width="108"/>
        </Grid.ColumnDefinitions>
        <CheckBox x:Name="SelectAllBox" Style="{StaticResource Tick}" IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center" PreviewMouseLeftButtonDown="SelectAll_Down" ToolTip="Select the mods in this list"/>
        <Button x:Name="NameSort" Grid.Column="1" Content="Name  ^" Style="{StaticResource SortButton}" HorizontalAlignment="Left" Click="NameSort_Click"/>
        <Button x:Name="KindSort" Grid.Column="2" Content="Kind" Style="{StaticResource SortButton}" HorizontalAlignment="Left" Click="KindSort_Click" ToolTip="Core, then framework, then addon"/>
        <Button x:Name="SizeSort" Grid.Column="3" Content="Size" Style="{StaticResource SortButton}" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Margin="0,0,18,0" Click="SizeSort_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ModRow}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Background="Transparent" MouseLeftButtonDown="Row_Down" ToolTip="{Binding FolderPath}">
              <Grid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="RowMenu_Opened">
                  <MenuItem Header="View" Click="MenuView_Click"/>
                  <MenuItem Header="Open folder" Click="MenuOpen_Click"/>
                  <MenuItem Header="Workshop page" Click="MenuWorkshop_Click"/>
                  <MenuItem Header="Copy id" Click="MenuCopy_Click"/>
                  <MenuItem Header="Copy launch line" Click="MenuLaunch_Click"/>
                  <MenuItem Header="Turn off" Tag="power" Click="MenuPower_Click"/>
                  <MenuItem Header="Share" Click="MenuShare_Click"/>
                  <MenuItem Header="Remove" Click="MenuRemove_Click"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource Accent}">
                <Rectangle.Style>
                  <Style TargetType="Rectangle">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Selected}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Rectangle.Style>
              </Rectangle>
              <Grid Margin="8,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="108"/>
                  <ColumnDefinition Width="108"/>
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" PreviewMouseLeftButtonDown="Check_Down"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Disabled}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,18,0" Typography.NumeralAlignment="Tabular"/>
              </Grid>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel x:Name="EmptyPane" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
        <Image Source="pack://application:,,,/Assets/mark.png" Width="48" Height="48" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="No mods" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        <TextBlock Text="Nothing in the usual Arma Reforger addon folders. Add the folder where yours live." Width="340" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,16"/>
        <Button Content="Add folder" Width="120" HorizontalAlignment="Center" Style="{StaticResource AccentButton}" Click="Folders_Click"/>
      </StackPanel>

      <TextBlock x:Name="BusyText" Text="Reading addon folders..." Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
      <TextBlock x:Name="NoMatchText" Text="No matches" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
    </Grid>

    <Grid x:Name="ModPage" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource Bg}">
      <DockPanel Margin="28,16,28,18">
        <Button DockPanel.Dock="Top" Content="Back" Width="84" HorizontalAlignment="Left" Margin="0,0,0,16" Click="PageBack_Click"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0">
          <Button Content="Folder" Width="84" Margin="0,0,8,0" Click="PageFolder_Click"/>
          <Button Content="Workshop" Width="96" Margin="0,0,8,0" Click="PageWorkshop_Click"/>
          <Button x:Name="PagePowerBtn" Content="Turn off" MinWidth="96" Click="PagePower_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Name="PageTitle" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="PageMeta" Margin="0,8,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <TextBlock Text="Id" Margin="0,22,0,0" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="PageId" Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap"/>
            <TextBlock Text="Folder" Margin="0,18,0,0" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="PageFolder" Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap"/>
            <TextBlock Text="Needs" Margin="0,18,0,0" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="PageNeeds" Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap"/>
            <TextBlock Text="Used by" Margin="0,18,0,0" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="PageUsed" Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <Border Grid.Row="3" Background="#1C1E19" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="16,12" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="CancelBtn" Content="Cancel" Width="84" Margin="0,0,8,0" Visibility="Collapsed" Click="Cancel_Click"/>
          <Button x:Name="OnBtn" Content="On" MinWidth="56" Margin="0,0,8,0" Click="On_Click" ToolTip="Put the selected mods back in the addon folder"/>
          <Button x:Name="OffBtn" Content="Off" MinWidth="56" Margin="0,0,8,0" Click="Off_Click" ToolTip="Move the selected mods aside so the game does not load them"/>
          <Button x:Name="IdsBtn" Content="Ids" MinWidth="56" Margin="0,0,8,0" Click="Ids_Click" ToolTip="Copy a launch line for the selected mods"/>
          <Button x:Name="ShowBtn" Content="Show" Width="84" Margin="0,0,8,0" Click="Show_Click" ToolTip="Open the selected addon folder"/>
          <Button x:Name="ShareBtn" MinWidth="96" Margin="0,0,8,0" Style="{StaticResource AccentButton}" Click="Share_Click" ToolTip="Zip the addon files so someone else can import them">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                <Canvas Width="16" Height="16">
                  <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M1.5,8.5 H14.5 V14.5 H1.5 Z M8,1.2 L11.4,4.6 H9.3 V8 H6.7 V4.6 H4.6 Z"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Share" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="RemoveBtn" MinWidth="104" Style="{StaticResource DangerButton}" Click="Remove_Click" ToolTip="Send the selected mods to the Recycle Bin">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                <Canvas Width="16" Height="16">
                  <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M5,1.6 H11 V3.4 H14.2 V4.8 H1.8 V3.4 H5 Z M3.3,6.2 H12.7 L12,14.4 H4 Z"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Remove" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Text="Select mods to remove or share"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
